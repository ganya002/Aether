[Unit]
Description=Aether session server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/aether-sessiond
Restart=on-failure
User=root
WorkingDirectory=/var/lib/aether
EnvironmentFile=-/etc/aether/public.env
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
